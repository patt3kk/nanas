# Application
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
MAX_JSON_BODY_SIZE=1mb
UPLOAD_MAX_FILE_SIZE_MB=10
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY=1
CORS_ORIGINS=https://nanasakara.ng,https://admin.nanasakara.ng

# Database
MONGODB_URI=mongodb://mongo:27017/nanas_akara
MONGODB_CONNECT_RETRIES=5
MONGODB_CONNECT_RETRY_DELAY_MS=2000
DB_URI=

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
ACCESS_TOKEN_SECRET=

# Pricing and delivery
DEFAULT_DELIVERY_FEE=1200

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_NAME=

# Frontend and admin URLs
FRONTEND_URL=https://nanasakara.ng
ADMIN_URL=https://admin.nanasakara.ng
FRONTEND_API_BASE_URL=https://api.nanasakara.ng
ENABLE_MOCK=false

# Email and notifications
FROM_EMAIL="Nana's Akara <no-reply@nanasakara.ng>"
ADMIN_ALERT_EMAIL=ops@nanasakara.ng
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Initial admin seed
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@nanasakara.ng
SUPER_ADMIN_PASSWORD=replace-with-a-strong-admin-password

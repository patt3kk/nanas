NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
MAX_JSON_BODY_SIZE=1mb
UPLOAD_MAX_FILE_SIZE_MB=10
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY=
CORS_ORIGINS=

# Database
MONGODB_URI=mongodb://localhost:27017/nanas_akara
MONGODB_CONNECT_RETRIES=5
MONGODB_CONNECT_RETRY_DELAY_MS=2000

# Legacy database variable (supported as a fallback if MONGODB_URI is not set)
DB_URI=

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d

# Legacy auth variable (supported as a fallback if JWT_SECRET is not set)
ACCESS_TOKEN_SECRET=

# Delivery / pricing
DEFAULT_DELIVERY_FEE=1200

# Paystack
# For local development you can use Paystack test keys.
# For production use Paystack live keys.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Paystack webhook signature secret.
# Required in production.
PAYSTACK_WEBHOOK_SECRET=

# Frontend URLs (required in production for CORS and Paystack callback URL)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173

# Email
FROM_EMAIL="Nana's Akara <no-reply@nanasakara.com>"
ADMIN_ALERT_EMAIL=

# Prefer Resend in production; if RESEND_API_KEY is not set, the backend will attempt SMTP (if configured).
RESEND_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cloudinary (required if using the admin image upload endpoints)
CLOUDINARY_CLOUD_NAME=

# Legacy Cloudinary variable (supported as a fallback if CLOUDINARY_CLOUD_NAME is not set)
CLOUDINARY_NAME=

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: seed a super-admin user (only used by `npm run seed`)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@nanasakara.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-admin-password
